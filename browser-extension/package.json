{
  "name": "raijin-browser-extension",
  "description": "Capture browser downloads and send them to the Raijin download manager.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv2",
    "sign:firefox": "web-ext sign --source-dir .output/firefox-mv2",
    "compile": "vue-tsc --noEmit",
    "test": "node --test utils/*.test.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "vue": "^3.5.29"
  },
  "devDependencies": {
    "@wxt-dev/module-vue": "^1.0.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vue-tsc": "^3.2.5",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
